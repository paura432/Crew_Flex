{
  "name": "crew-flex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e:remote": "node --env-file=.env.e2e node_modules/vitest/vitest.mjs run tests/e2e",
    "e2e:production": "node --env-file=.env.e2e.production node_modules/vitest/vitest.mjs run tests/e2e/remote-smoke.test.ts",
    "test:edge": "deno test --config supabase/functions/deno.json --allow-env supabase/functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm format:check && pnpm lint:edge && pnpm typecheck:edge && pnpm test:edge",
    "db:types": "supabase gen types typescript --project-id sbjkzrkmcekokkqiuvvh --schema public > src/types/database.generated.ts",
    "db:types:local": "bash scripts/local/db-types.sh",
    "prepare": "husky",
    "lint:edge": "deno lint --config supabase/functions/deno.json supabase/functions"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24"
  }
}
