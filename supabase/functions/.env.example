# Local `supabase functions serve --env-file supabase/functions/.env` only. Never deployed.
# CORS fails closed: without ALLOWED_ORIGINS no browser origin is allowed, in every environment.
# The production value is a Supabase secret (docs/architecture/ENVIRONMENTS.md):
#   supabase secrets set --project-ref sbjkzrkmcekokkqiuvvh ALLOWED_ORIGINS=https://crew-flex.vercel.app
# Localhost belongs here, in the local file, never in a remote secret.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Phase 6 platform-admin review (OPEN_DECISIONS OD-3): enabled locally only. Never set remotely
# before the owner approves who verifies qualifications.
QUALIFICATION_REVIEW_ENABLED=true
# Document wallet (professional-documents): locally the runtime reaches the API as http://kong:8000,
# which a browser cannot open; signed URLs are rewritten to this public origin. Leave unset remotely
# (the hosted SUPABASE_URL is already public). Not a secret.
STORAGE_PUBLIC_URL=http://127.0.0.1:56321
