# Local `supabase functions serve --env-file supabase/functions/.env` only. Never deployed.
# CORS fails closed: without ALLOWED_ORIGINS no browser origin is allowed, in every environment.
# Production/staging values are Supabase secrets (docs/architecture/ENVIRONMENTS.md), e.g.
#   supabase secrets set --project-ref <staging-ref> ALLOWED_ORIGINS=https://<staging-origin>
# Localhost belongs here, in the local file, never in a remote secret.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
