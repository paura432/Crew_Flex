# Remote E2E (tests/e2e/remote-smoke.test.ts, scripts/e2e/*.sh). Copy to `.env.e2e` (git-ignored).
# Crew Flex has ONE Supabase project (= production, OD-9): the runner refuses writes unless
#   1. E2E_SUPABASE_URL belongs to E2E_AUTHORIZED_PROJECT_REF (and to the linked project), and
#   2. E2E_WRITE_CONFIRM=WRITE:<ref>:<YYYY-MM-DD, UTC> is typed on the command line for that run.
# Never put E2E_WRITE_CONFIRM in this file. Only synthetic, confirmed accounts (e-mails starting with
# `e2e` or containing `+e2e`). Never real people, never a service role or secret key.
E2E_AUTHORIZED_PROJECT_REF=
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_PRO_A_EMAIL=
E2E_PRO_A_PASSWORD=
E2E_PRO_B_EMAIL=
E2E_PRO_B_PASSWORD=
E2E_ORG_ADMIN_EMAIL=
E2E_ORG_ADMIN_PASSWORD=
