# Remote E2E (tests/e2e/remote-smoke.test.ts). Copy to `.env.e2e` (ignored). STAGING ONLY: the
# runner refuses the production project ref.
# Only synthetic, confirmed test accounts. Never real people, never production credentials
# of a real user, never a service role or secret key. Passwords live only in the local file.
# Only while no staging project exists (owner decision 2026-10-09): E2E_ALLOW_PRODUCTION=1
E2E_ALLOW_PRODUCTION=
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_PRO_A_EMAIL=
E2E_PRO_A_PASSWORD=
E2E_PRO_B_EMAIL=
E2E_PRO_B_PASSWORD=
E2E_ORG_ADMIN_EMAIL=
E2E_ORG_ADMIN_PASSWORD=
